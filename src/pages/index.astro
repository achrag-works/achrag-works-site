---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ACHRAG Engineering Division</title>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%;
      background: #0a0a0a;
      color: #e8e4de;
      font-family: 'Courier New', Courier, monospace;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .container { text-align: center; padding: 2rem; }
    .org {
      font-size: 11px;
      letter-spacing: 0.35em;
      color: #5a5248;
      text-transform: uppercase;
      margin-bottom: 3rem;
    }
    .title {
      font-size: 15px;
      letter-spacing: 0.2em;
      color: #c8c0b4;
      margin-bottom: 1rem;
      font-weight: normal;
    }
    .rule { width: 32px; height: 1px; background: #3a3430; margin: 2rem auto; }
    .message {
      font-size: 12px;
      letter-spacing: 0.12em;
      color: #4a4440;
      line-height: 2.2;
    }
  </style>
</head>
<body>
  <div class="container">
    <p class="org">ACHRAG Engineering Division</p>
    <p class="title">Under Maintenance</p>
    <div class="rule"></div>
    <p class="message">
      We will be back shortly.<br>
      ただいまメンテナンス中です。
    </p>
  </div>
</body>
</html>
