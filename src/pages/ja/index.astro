---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="近日公開">
  <style>
    .coming-soon {
      text-align: center;
      padding: 6rem 0;
    }
    .coming-soon img {
      height: 80px;
      width: 80px;
      opacity: 0.8;
      margin-bottom: 2rem;
    }
    .label {
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }
    .coming-soon h1 {
      font-size: 2.5rem;
      font-weight: 300;
      margin-bottom: 1rem;
      color: var(--text);
    }
    .coming-soon p {
      color: var(--text-muted);
      font-size: 1rem;
      max-width: 500px;
      margin: 0 auto 2.5rem;
      line-height: 1.8;
    }
    .en-link {
      display: inline-block;
      color: var(--link);
      font-size: 0.9rem;
      text-decoration: none;
      border-bottom: 1px solid var(--link);
      padding-bottom: 2px;
    }
    .en-link:hover { opacity: 0.8; }
  </style>

  <div class="coming-soon">
    <img src="/achrag-icon.png" alt="ACHRAG" />
    <p class="label">ACHRAG WORKS</p>
    <h1>近日公開</h1>
    <p>日本語サイトは現在準備中です。<br>今しばらくお待ちください。</p>
    <a href="/" class="en-link">English version →</a>
  </div>
</Layout>
