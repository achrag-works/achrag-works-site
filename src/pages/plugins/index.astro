---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Plugins">
  <style>
    h1 { font-size: 2rem; font-weight: 300; margin-bottom: 0.5rem; }
    .subtitle { color: var(--text-muted); margin-bottom: 3rem; }
    .plugin-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2rem;
      margin-bottom: 1.5rem;
    }
    .plugin-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .plugin-icon { font-size: 2rem; }
    .plugin-card h2 { font-size: 1.2rem; font-weight: 500; }
    .plugin-card p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem; }
    .tag {
      display: inline-block;
      background: var(--bg2);
      color: var(--text-muted);
      font-size: 0.75rem;
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
      margin-right: 0.4rem;
    }
    .card-link { color: var(--accent); font-size: 0.9rem; text-decoration: none; font-weight: 500; }
  </style>

  <h1>Plugins</h1>
  <p class="subtitle">Free WordPress plugins by ACHRAG</p>

  <div class="plugin-card">
    <div class="plugin-header">
      <span class="plugin-icon">漢</span>
      <h2>ACHRAG Kanji Number Converter</h2>
    </div>
    <p>Converts Arabic numerals in post titles and content into traditional Japanese Kanji numerals. Ideal for classical, literary, or scholarly Japanese publications.</p>
    <div style="margin-bottom: 1rem;">
      <span class="tag">WordPress</span>
      <span class="tag">Japanese</span>
      <span class="tag">Free</span>
      <span class="tag">v2.8</span>
    </div>
    <a href="/plugins/kanji-converter" class="card-link">View details →</a>
  </div>

  <div class="plugin-card">
    <div class="plugin-header">
      <span class="plugin-icon">🎙</span>
      <h2>Simple-Multi-Agent Chat</h2>
    </div>
    <p>A single HTML file for three-way conversations with two independent Claude AI agents. Configure each agent's personality, relay messages between them, and broadcast to both simultaneously — no installation, no server required.</p>
    <div style="margin-bottom: 1rem;">
      <span class="tag">Browser Tool</span>
      <span class="tag">Claude API</span>
      <span class="tag">Free</span>
      <span class="tag">v1.0</span>
    </div>
    <a href="/plugins/multi-agent-chat" class="card-link">View details →</a>
  </div>
</Layout>
