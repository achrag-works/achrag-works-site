---
import Layout from '../../layouts/Layout.astro';
const AUTH_BASE = 'https://auth.achrag.dev';
const TURNSTILE_SITE_KEY = '0x4AAAAAADgVP0BAK9L-C9-9';
---
<Layout title="Login">
<style>
  .auth-wrap { max-width:440px; margin:4rem auto; }
  .auth-label { font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--accent); margin-bottom:0.75rem; }
  .auth-title { font-size:1.8rem; font-weight:300; margin-bottom:0.5rem; }
  .auth-sub { color:var(--text-muted); font-size:0.92rem; margin-bottom:2.5rem; }
  .form-group { margin-bottom:1.25rem; }
  label { display:block; font-size:0.8rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.4rem; }
  input { width:100%; background:#060f06; border:1px solid #1a2a1a; border-radius:4px; padding:0.7rem 1rem; color:var(--text); font-size:0.95rem; font-family:inherit; outline:none; transition:border-color 0.2s; }
  input:focus { border-color:var(--accent); }
  .forgot { display:block; text-align:right; font-size:0.8rem; color:var(--link); text-decoration:none; margin-top:0.35rem; }
  .turnstile-wrap { margin-bottom:1.25rem; }
  .btn-primary { width:100%; background:var(--accent); color:white; border:none; border-radius:4px; padding:0.8rem; font-size:0.95rem; font-family:inherit; cursor:pointer; margin-top:0.5rem; transition:opacity 0.2s; }
  .btn-primary:hover { opacity:0.85; }
  .btn-primary:disabled { opacity:0.5; cursor:not-allowed; }
  .divider { border:none; border-top:1px solid #1a2a1a; margin:2rem 0; }
  .footer-link { text-align:center; font-size:0.88rem; color:var(--text-muted); }
  .footer-link a { color:var(--link); text-decoration:none; }
  .msg { padding:0.75rem 1rem; border-radius:4px; font-size:0.88rem; margin-bottom:1.25rem; display:none; }
  .msg.success { background:#0a1f0a; border:1px solid #1a4a1a; color:#7ec87e; display:block; }
  .msg.error   { background:#1f0a0a; border:1px solid #4a1a1a; color:#c87e7e; display:block; }
</style>

<div class="auth-wrap">
  <div class="auth-label">My Page</div>
  <h1 class="auth-title">Sign In</h1>
  <p class="auth-sub">ライセンス管理・ドメイン変更・購入履歴はこちらから。</p>

  <div id="msg" class="msg"></div>

  <form id="login-form">
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="you@example.com" required />
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="••••••••" required />
      <a href="/mypage/reset" class="forgot">パスワードを忘れた方</a>
    </div>
    <div class="turnstile-wrap">
      </div>
    <input type="text" name="_hp" id="_hp" style="display:none;position:absolute;left:-9999px;" autocomplete="off" tabindex="-1">
    <button type="submit" class="btn-primary" id="submit-btn">ログイン</button>
  </form>

  <hr class="divider" />
  <p class="footer-link">アカウントをお持ちでない方は <a href="/mypage/register">新規登録</a></p>
</div>

<script define:vars={{ AUTH_BASE }}>
  const form = document.getElementById('login-form');
  const msg  = document.getElementById('msg');
  const btn  = document.getElementById('submit-btn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.className = 'msg';
    msg.textContent = '';

    if (!tsToken) {
      msg.className = 'msg error';
      msg.textContent = '画面の認証を完了してください。';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'ログイン中...';

    const email    = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    try {
      const res  = await fetch(`${AUTH_BASE}/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, credentials: 'include',
      });
      const data = await res.json();

      if (res.ok) {
        window.location.href = '/mypage';
      } else {
        const errMap = {
          invalid_credentials: 'メールアドレスまたはパスワードが正しくありません。',
          email_not_verified:  'メール認証が完了していません。送信されたメールを確認してください。',
          account_suspended:   'このアカウントは停止されています。',
          too_many_attempts:   'ログイン試行回数が多すぎます。しばらくしてから再試行してください。',
          turnstile_failed:    'Bot認証に失敗しました。ページを再読み込みして再度お試しください。',
        };
        msg.className = 'msg error';
        msg.textContent = errMap[data.error] || `エラー: ${data.error}`;
        btn.disabled = false;
        btn.textContent = 'ログイン';
        if (}
    } catch {
      msg.className = 'msg error';
      msg.textContent = 'ネットワークエラーが発生しました。';
      btn.disabled = false;
      btn.textContent = 'ログイン';
      if (}
  });
</script>
</Layout>
