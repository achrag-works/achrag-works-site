---
import Layout from '../../layouts/Layout.astro';
const AUTH_BASE = 'https://auth.achrag.dev';
const TURNSTILE_SITE_KEY = '0x4AAAAAADgVP0BAK9L-C9-9';
---
<Layout title="Password Reset">
<style>
  .auth-wrap { max-width:440px; margin:4rem auto; }
  .auth-label { font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--accent); margin-bottom:0.75rem; }
  .auth-title { font-size:1.8rem; font-weight:300; margin-bottom:0.5rem; }
  .auth-sub { color:var(--text-muted); font-size:0.92rem; margin-bottom:2.5rem; }
  .form-group { margin-bottom:1.25rem; }
  label { display:block; font-size:0.8rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.4rem; }
  input { width:100%; background:#060f06; border:1px solid #1a2a1a; border-radius:4px; padding:0.7rem 1rem; color:var(--text); font-size:0.95rem; font-family:inherit; outline:none; transition:border-color 0.2s; }
  input:focus { border-color:var(--accent); }
  .hint { font-size:0.78rem; color:var(--text-muted); margin-top:0.35rem; }
  .turnstile-wrap { margin-bottom:1.25rem; }
  .btn-primary { width:100%; background:var(--accent); color:white; border:none; border-radius:4px; padding:0.8rem; font-size:0.95rem; font-family:inherit; cursor:pointer; margin-top:0.5rem; transition:opacity 0.2s; }
  .btn-primary:hover { opacity:0.85; }
  .btn-primary:disabled { opacity:0.5; cursor:not-allowed; }
  .divider { border:none; border-top:1px solid #1a2a1a; margin:2rem 0; }
  .footer-link { text-align:center; font-size:0.88rem; color:var(--text-muted); }
  .footer-link a { color:var(--link); text-decoration:none; }
  .msg { padding:0.75rem 1rem; border-radius:4px; font-size:0.88rem; margin-bottom:1.25rem; display:none; }
  .msg.success { background:#0a1f0a; border:1px solid #1a4a1a; color:#7ec87e; display:block; }
  .msg.error   { background:#1f0a0a; border:1px solid #4a1a1a; color:#c87e7e; display:block; }
</style>

<div class="auth-wrap">
  <div class="auth-label">My Page</div>
  <h1 class="auth-title" id="page-title">パスワードリセット</h1>
  <p class="auth-sub" id="page-sub">登録メールアドレスにリセットリンクを送信します。</p>

  <div id="msg" class="msg"></div>

  <!-- Step 1: メール入力 -->
  <form id="request-form">
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="you@example.com" required />
    </div>
    <div class="turnstile-wrap">
      </div>
    <input type="text" name="_hp" id="_hp" style="display:none;position:absolute;left:-9999px;" autocomplete="off" tabindex="-1">
    <button type="submit" class="btn-primary" id="request-btn">リセットメールを送信</button>
  </form>

  <!-- Step 2: 新パスワード入力（tokenあり時） -->
  <form id="reset-form" style="display:none;">
    <div class="form-group">
      <label for="new-password">新しいパスワード</label>
      <input type="password" id="new-password" placeholder="••••••••" required />
      <p class="hint">8文字以上、大文字・小文字・数字・記号（2文字以上）を含むこと</p>
    </div>
    <div class="form-group">
      <label for="new-password2">確認</label>
      <input type="password" id="new-password2" placeholder="••••••••" required />
    </div>
    <input type="text" name="_hp" id="_hp" style="display:none;position:absolute;left:-9999px;" autocomplete="off" tabindex="-1">
    <button type="submit" class="btn-primary" id="reset-btn">パスワードを変更する</button>
  </form>

  <hr class="divider" />
  <p class="footer-link"><a href="/mypage/login">ログインに戻る</a></p>
</div>

<script define:vars={{ AUTH_BASE }}>
  const params = new URLSearchParams(window.location.search);
  const token  = params.get('token');

  // tokenがあればStep2（新パスワード入力）を表示
  if (token) {
    document.getElementById('request-form').style.display = 'none';
    document.getElementById('reset-form').style.display = 'block';
    document.getElementById('page-title').textContent = '新しいパスワードを設定';
    document.getElementById('page-sub').textContent   = '新しいパスワードを入力してください。';
  }

  // Step 1: リセットメール送信
  document.getElementById('request-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = document.getElementById('msg');
    const btn = document.getElementById('request-btn');
    msg.className = 'msg';

    if (!tsToken) { msg.className='msg error'; msg.textContent='画面の認証を完了してください。'; return; }

    btn.disabled = true;
    btn.textContent = '送信中...';

    try {
      const res  = await fetch(`${AUTH_BASE}/password/reset-request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: document.getElementById('email').value.trim(), credentials: 'include',
      });
      // セキュリティのため成否に関わらず同じメッセージ
      msg.className = 'msg success';
      msg.textContent = 'メールアドレスが登録済みの場合、リセットリンクを送信しました。';
      e.target.style.display = 'none';
    } catch {
      msg.className = 'msg error';
      msg.textContent = 'ネットワークエラーが発生しました。';
      btn.disabled = false;
      btn.textContent = 'リセットメールを送信';
      if (}
  });

  // Step 2: パスワード変更実行
  document.getElementById('reset-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg  = document.getElementById('msg');
    const btn  = document.getElementById('reset-btn');
    const pw   = document.getElementById('new-password').value;
    const pw2  = document.getElementById('new-password2').value;
    msg.className = 'msg';

    if (pw !== pw2) { msg.className='msg error'; msg.textContent='パスワードが一致しません。'; return; }

    btn.disabled = true;
    btn.textContent = '変更中...';

    try {
      const res  = await fetch(`${AUTH_BASE}/password/reset`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, new_password: pw }),
        credentials: 'include',
      });
      const data = await res.json();

      if (res.ok) {
        msg.className = 'msg success';
        msg.textContent = 'パスワードを変更しました。ログインページへ移動します...';
        e.target.style.display = 'none';
        setTimeout(() => window.location.href = '/mypage/login', 2000);
      } else {
        const errMap = {
          invalid_token:  'このリンクは無効です。',
          expired_token:  'リンクの有効期限が切れています。再度リセットを申請してください。',
          already_used:   'このリンクはすでに使用済みです。',
          password_too_short: 'パスワードは8文字以上にしてください。',
          password_needs_two_special_chars: '記号を2文字以上含めてください。',
        };
        msg.className = 'msg error';
        msg.textContent = errMap[data.error] || `エラー: ${data.error}`;
        btn.disabled = false;
        btn.textContent = 'パスワードを変更する';
      }
    } catch {
      msg.className = 'msg error';
      msg.textContent = 'ネットワークエラーが発生しました。';
      btn.disabled = false;
      btn.textContent = 'パスワードを変更する';
    }
  });
</script>
</Layout>
