---
interface Props {
  title: string;
  description?: string;
  noCache?: boolean;
}
const { title, description = "ACHRAG Works — WordPress plugins by ACHRAG", noCache = false } = Astro.props;

const isMyPage = Astro.url.pathname.startsWith('/mypage');
if (isMyPage || noCache) {
  Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
  Astro.response.headers.set('Pragma', 'no-cache');
  Astro.response.headers.set('Surrogate-Control', 'no-store');
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | ACHRAG Works</title>
  {(isMyPage || noCache) && (
    <>
      <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
      <meta http-equiv="Pragma" content="no-cache" />
      <meta http-equiv="Expires" content="0" />
    </>
  )}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Noto+Serif+JP:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #000B00;
      --bg2: #001020;
      --text: #EAF4FC;
      --text-muted: #a0b8cc;
      --accent: #D4856A;
      --accent2: #bb7125;
      --accent3: #cab356;
      --link: #78cdd0;
      --border: #1a2a1a;
      --white: #111314;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      font-size: 16px;
    }

    header {
      background: #000d00;
      border-bottom: 1px solid var(--border);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      letter-spacing: 0.05em;
    }

    .logo span {
      color: var(--accent);
    }

    nav a {
      color: var(--link);
      text-decoration: none;
      font-size: 0.9rem;
      margin-left: 1.5rem;
      transition: color 0.2s;
    }

    nav a:hover { color: var(--accent); }

    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 2rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    footer a {
      color: var(--accent);
      text-decoration: none;
    }
  </style>
</head>
<body>
  <header>
    <a href="/" class="logo"><img src="/achrag-icon.png" alt="ACHRAG" style="height:24px;width:24px;vertical-align:middle;margin-right:0.5rem;" />ACHRAG <span>Works</span></a>
    <nav>
      <a href="/news">What's New</a>
      <a href="/mypage/register">Register</a>
      <a href="/mypage">My Page</a>
      <a href="/plugins">Plugins</a>
      <a href="/ja">&#26085;&#26412;&#35486;</a>
      <a href="https://www.achrag.org/" target="_blank">ACHRAG.org</a>
      <a href="https://github.com/achrag-works" target="_blank">GitHub</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>&copy; 2026 <a href="https://www.achrag.org/">ACHRAG</a> &mdash; Advanced Civilizational Heritage Research &amp; Analysis Group</p>
  </footer>
</body>
</html>
